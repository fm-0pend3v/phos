#!/usr/bin/env bash

# ================================ #
# 1. CONTROLLO SERVIZI DI SISTEMA
# ================================ #
SYSTEM_UNITS=("sddm.service")

echo "--- Controllo servizi di sistema ---"
for unit in "${SYSTEM_UNITS[@]}"; do
    # Controllo abilitazione (is-enabled)
    if systemctl is-enabled --quiet "$unit"; then
        echo "[OK] $unit è già abilitato."
    else
        echo "[AZIONE] $unit non è abilitato. Abilitazione in corso..."
        systemctl enable "$unit"
    fi

    # Controllo esecuzione (is-active)
    if systemctl is-active --quiet "$unit"; then
        echo "[OK] $unit è già avviato."
    else
        echo "[AZIONE] $unit non è avviato. Avvio in corso..."
        sudo systemctl start "$unit"
    fi
done

echo ""
